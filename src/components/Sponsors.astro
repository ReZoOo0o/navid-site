---
import { t } from '../lib/i18n';
import { loadFacts, loadOffer, pick } from '../lib/content';
import { fill, localizeDigits } from '../lib/format';
interface Props { locale: 'en' | 'fa' }
const { locale } = Astro.props;
const s = t(locale);
const o = loadOffer();
const f = loadFacts();
if (o.needs.length === 0 && locale === 'en') {
  console.warn('\n  ⚠ sponsor section is shipping WITHOUT a gear list (offer.yaml needs: []).\n    The named list is the ask. Chase Q26.\n');
}
const vars = {
  v1: localizeDigits(f.viewsTopFilm, locale), v2: localizeDigits(f.viewsSecondFilm, locale),
  v30: localizeDigits(f.views30d, locale), i30: localizeDigits(f.interactions30d, locale),
  reach: localizeDigits(f.nonFollowerReach, locale),
};
---
<section id="sponsors" class="px-6 py-16 md:px-16" style="background: var(--c-band); color: var(--c-band-ink);">
  <div class="grid gap-10 md:grid-cols-2 md:gap-14">
    <div class="reveal flex flex-col gap-5">
      <p class="kicker" style="color: var(--c-band-dim);">{s['sponsor.label']}</p>
      <h2 class="max-w-[24ch] text-[30px] font-light leading-[1.3]">{s['sponsor.lead']}</h2>
      <p class="max-w-[52ch] text-[14px] leading-[1.6]" style="color: var(--c-band-text);">{fill(pick(o.proves[2], locale), vars)}</p>
      {/* Credentials sit with the pitch; the right column is only the ask.
          Before the gear list existed this line led the right column, which
          left it reading as a heading for the list of things he does NOT have. */}
      <p class="text-[15px] leading-[1.6]" style="color: var(--c-band-text);">{s['sponsor.already']} <strong style="color: var(--c-band-ink);">{o.ridesAlready.join(' · ')}</strong></p>
    </div>
    <div class="reveal flex flex-col justify-center gap-4">
      {o.needs.length > 0 ? (
        <>
        {/* The list needs its own label: unlabelled, it sits directly under
            "already in frame" and reads as more of what he HAS, not what he
            is asking for. The label renders only when there is a list. */}
        <p class="kicker" style="color: var(--c-band-dim);">{s['sponsor.needsLabel']}</p>
        <ul class="flex flex-col gap-2.5" role="list">
          {o.needs.map((n) => (
            <li class="flex gap-3">
              <span aria-hidden="true" style="color: var(--c-band-dim);">→</span>
              <span class="leading-[var(--lh-body)]" style="font-size: var(--t-lead)">
                <strong style="color: var(--c-band-ink);">{pick(n.item, locale)}</strong>
                <span style="color: var(--c-band-text);"> — {pick(n.why, locale)}</span>
              </span>
            </li>
          ))}
        </ul>
        </>
      ) : (
        <p class="leading-[var(--lh-body)]" style="font-size: var(--t-lead); color: var(--c-band-text);">{s['sponsor.needsAsk']}</p>
      )}
      <p class="text-[11px] leading-[1.6]" style="color: var(--c-band-dim);">{s['sponsor.stale']} (<bdi dir="ltr">{f.metricsWindow}</bdi>)</p>
    </div>
  </div>
</section>
