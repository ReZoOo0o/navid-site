---
import { t } from '../lib/i18n';
interface Props { locale: 'en' | 'fa' }
const { locale } = Astro.props;
const s = t(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const altHref = base + (locale === 'fa' ? '/' : '/fa/');
const altLang = locale === 'fa' ? 'en' : 'fa';
---
<a href="#main" class="skip-link mono text-[12px]">{s['nav.skip']}</a>
<header class="flex items-center justify-between gap-3 border-b px-4 py-4 md:px-16 md:py-5" style="border-color: var(--c-hairline);">
  <div class="flex min-w-0 items-center gap-3">
    <span class="mono truncate text-[11px] tracking-[0.1em] md:text-[12px] md:tracking-[0.18em]">{s['nav.unit']}</span>
  </div>
  <nav aria-label={s['nav.ariaLabel']} class="flex shrink-0 items-center gap-3 md:gap-4">
    <span class="hidden items-center gap-4 lg:flex">
      {[['#story', s['nav.story']], ['#essay', s['nav.essay']], ['#track', s['nav.track']], ['#work', s['nav.work']]].map(([href, label]) => (
        <a href={href} class="mono inline-flex items-center text-[11px] tracking-[0.14em]"
           style="color: var(--c-body2); min-height: 44px; padding: 0 2px;">{label}</a>
      ))}
    </span>
    <a href={altHref} lang={altLang} hreflang={altLang} class="inline-flex items-center" style="color: var(--c-body2); font-size: var(--t-small); min-height: 44px; padding: 0 6px;">{s['langswitch.label']}</a>
    <a href="#contact" class="cta-primary no-print whitespace-nowrap px-3 py-2 text-[13px] font-bold md:px-5 md:py-2.5">{s['nav.cta']}</a>
  </nav>
</header>
