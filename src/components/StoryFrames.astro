---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import 'photoswipe/style.css';
import { framesFor, loadFacts, loadStory, pick } from '../lib/content';
import { fill, localizeDigits, startDateText } from '../lib/format';
interface Props { locale: 'en' | 'fa' }
const { locale } = Astro.props;
const f = loadFacts();
const frames = framesFor(loadStory().chapters);
// Photographs are data (story.yaml → chapter.photo.file), resolved against the
// folder at build time. A file named in the data but absent from the folder
// fails the build here instead of shipping a broken figure.
// FOLDER RULE: every JPEG matched by this glob must end up in an <Image> or
// getImage(). The bundler emits each globbed file whether or not it is used
// (lazy globs too — measured 2026-09-06), and an unused one ships as its raw
// multi-megabyte original and trips the 350KB guard. Retired photographs
// live in src/assets/photos/library/, out of the glob's reach.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const photoFor = (file: string): ImageMetadata => {
  const hit = photoFiles[`../assets/photos/${file}`];
  if (!hit) throw new Error(`story.yaml names a photo that is not in src/assets/photos/: ${file}`);
  return hit.default;
};
const photos = frames.map((fr) => photoFor(fr.photo.file));
// Full-size target for the lightbox and for the no-JS link. Source width
// (1125), never upscaled. MEASURED 2026-09-06 against the 350KB image cap:
// quality 80 failed (Tatev 362KB, construction 371KB, Chronicle 403KB);
// quality 75 passes with the Chronicle at 331KB as the largest. If a future
// source pushes a variant over, drop quality before width.
const fulls = await Promise.all(
  photos.map((src) => getImage({ src, width: 1125, format: 'webp', quality: 75 })),
);
const start = startDateText(f.startDate, locale);
---
{frames.map((fr, i) => (
  <section class="frame md:grid md:grid-cols-2" data-frame={fr.id}>
    {/* The photo column is the START side — left in English, right in
        Persian — from grid order + dir alone; nothing is mirrored by hand.
        On the phone it is one full screen of photograph, then the words.
        From md it pins (sticky, top-0: the masthead is not sticky). 100svh
        where supported, 100vh otherwise. Print is handled in <style> below. */}
    <figure class="frame-fig flex h-screen flex-col supports-[height:100svh]:h-[100svh] md:sticky md:top-0">
      <a class="pswp-link relative block min-h-0 flex-1" href={fulls[i].src}
         data-pswp-width={fulls[i].attributes.width} data-pswp-height={fulls[i].attributes.height}
         target="_blank" rel="noopener">
        {/* 900w is the widest step that clears the 350KB cap for these dense
            portrait sources (same finding as the old Story figure). */}
        <Image src={photos[i]} alt={pick(fr.photo.alt, locale)} width={900} widths={[640, 900]}
               sizes="(min-width: 768px) 50vw, 100vw"
               class="block h-full w-full object-cover" />
        {/* The "opens whole" mark, drawn rather than typed: U+2922 (⤢) resolved
            to Apple Symbols here and is patchy on Android and Linux, so the
            glyph risked shipping as tofu. Two corner brackets, each with its
            diagonal, in currentColor. */}
        <span class="zoom" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            <path d="M10 4H4v6M4 4l6.5 6.5" />
            <path d="M14 20h6v-6M20 20l-6.5-6.5" />
          </svg>
        </span>
      </a>
      <figcaption class="flex h-auto min-h-10 shrink-0 items-center border-t px-4 py-2 text-[13px]"
                  style="border-color: var(--c-hairline); background: var(--c-ground); color: var(--c-body2);">{pick(fr.photo.caption, locale)}</figcaption>
    </figure>
    {/* The text column sets the frame's height, and the pin only reads if the
        frame is taller than the screen: 160svh means the photograph holds for
        sixty percent of a screen of scrolling before the next slides over it
        (measured 2026-09-06: padding alone left one-paragraph frames at exactly
        100vh, so nothing ever stuck). */}
    <div class="frame-txt flex flex-col justify-center gap-5 px-6 py-10 md:min-h-[160svh] md:px-16 md:py-[20svh] print:py-8">
      <p class="kicker">{localizeDigits(String(i + 1).padStart(2, '0'), locale)}</p>
      {fr.chapters.map((c) => (
        <p class="max-w-[62ch] leading-[var(--lh-body)]" style="font-size: var(--t-lead); color: var(--c-body2);">{fill(pick(c.body, locale), { start })}</p>
      ))}
    </div>
  </section>
))}
<style>
  /* The chip behind the mark. Logical inset so it sits at the end corner in both scripts. */
  .zoom { position: absolute; inset-inline-end: 12px; bottom: 12px; width: 28px; height: 28px; border-radius: 50%;
          display: flex; align-items: center; justify-content: center;
          background: color-mix(in srgb, var(--c-ground) 90%, transparent); color: var(--c-ink); }
  @media print { .zoom { display: none; } }

  /* PRINT — the PDF is laid out at the A4 printable width (~688px), BELOW the
     `md` breakpoint, so the grid, the pin and every `md:` rule are absent and
     each frame stacks: figure, then words. Left alone, a 9:16 photograph at
     688px is 1223px tall against ~1016px of usable page, and every frame was
     sliced across a page break — measured 2026-09-07: pages 3, 5, 7, 9 and 11
     of the 18-page PDF held nothing but the top of a photograph. Capping the
     picture at 150mm and forbidding a break inside the frame prints each one
     whole: photo, caption strip, words, one page. White margins beside the
     picture are the price, and are a design choice, not a bug. */
  @media print {
    .frame, .frame-fig { break-inside: avoid; page-break-inside: avoid; }
    .frame-fig { display: block; height: auto; }
    .frame-fig :global(img) {
      max-height: 150mm; width: auto; height: auto;
      margin-inline: auto; object-fit: contain;
    }
  }
</style>

<script>
  // Progressive enhancement over the plain full-size links. Only this shim
  // ships with the page; the PhotoSwipe core is fetched on the first tap.
  // Reduced motion: no open/close animation at all.
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lightbox = new PhotoSwipeLightbox({
    gallery: '#story',
    children: 'a.pswp-link',
    pswpModule: () => import('photoswipe'),
    showHideAnimationType: reduce ? 'none' : 'zoom',
    zoomAnimationDuration: reduce ? 0 : 333,
  });
  lightbox.init();
</script>
